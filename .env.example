APP_ENV=local
LOG_LEVEL=INFO
LLM_PROVIDER=mock          # mock | anthropic | azure_openai | bedrock | vertex
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
CLOUD_PROVIDER=aws         # aws | azure | gcp
